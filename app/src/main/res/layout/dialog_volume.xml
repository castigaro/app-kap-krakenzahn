<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_music_volume"
        android:textAppearance="?attr/textAppearanceBody2" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderMusicVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/settings_music_volume"
        android:stepSize="5"
        android:valueFrom="0"
        android:valueTo="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_ambience_volume"
        android:textAppearance="?attr/textAppearanceBody2" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderAmbienceVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/settings_ambience_volume"
        android:stepSize="5"
        android:valueFrom="0"
        android:valueTo="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_sfx_volume"
        android:textAppearance="?attr/textAppearanceBody2" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderSfxVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/settings_sfx_volume"
        android:stepSize="5"
        android:valueFrom="0"
        android:valueTo="100" />

</LinearLayout>
