<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay für das Duell der spitzen Zungen: Punktestand, Rasmus'
     Beleidigung und drei Konter-Optionen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duelOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C0101828"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/duelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/duel_title"
        android:textColor="@color/secondary"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/duelScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFF5F1E6"
        android:textAppearance="?attr/textAppearanceCaption" />

    <TextView
        android:id="@+id/duelInsult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#FFF5F1E6"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textStyle="italic" />

    <ProgressBar
        android:id="@+id/duelSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/duelOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
