<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Grundschicht: Szene oben, SCUMM-Bedienleiste unten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Szenenbereich mit den darüberliegenden Overlays -->
        <FrameLayout
            android:id="@+id/sceneContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.castigaro.kapkrakenzahn.render.SceneView
                android:id="@+id/sceneView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Ortsname oben links -->
            <TextView
                android:id="@+id/locationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="#66000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFF5F1E6"
                android:textAppearance="?attr/textAppearanceCaption" />

            <!-- Menü-Button oben rechts -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMenu"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:minWidth="0dp"
                android:text="@string/game_menu"
                android:textColor="#FFF5F1E6"
                android:background="#66000000" />

            <!-- Kommentar-/Beschreibungszeile über der Leiste -->
            <TextView
                android:id="@+id/commentBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#88000000"
                android:padding="10dp"
                android:textColor="#FFF5F1E6"
                android:textAppearance="?attr/textAppearanceBody2"
                android:visibility="gone" />

            <!-- Bedienleiste aus-/einblenden -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToggleControls"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="▾"
                android:textColor="#FFF5F1E6"
                android:textSize="24sp"
                android:background="#66000000"
                android:contentDescription="@string/toggle_controls" />
        </FrameLayout>

        <!-- SCUMM-Bedienleiste: Satzzeile + Verbtafel + Inventar -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/scumm_panel"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="6dp">

            <!-- Satzzeile („Benutze Laterne mit …") -->
            <TextView
                android:id="@+id/sentenceLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp"
                android:textColor="@color/scumm_sentence"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Verbtafel (zwei Spalten) -->
                <GridLayout
                    android:id="@+id/verbGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/verbWalk"
                        style="@style/ScummVerb"
                        android:text="@string/verb_walk" />

                    <TextView
                        android:id="@+id/verbLook"
                        style="@style/ScummVerb"
                        android:text="@string/verb_look" />

                    <TextView
                        android:id="@+id/verbTake"
                        style="@style/ScummVerb"
                        android:text="@string/verb_take" />

                    <TextView
                        android:id="@+id/verbUse"
                        style="@style/ScummVerb"
                        android:text="@string/verb_use" />

                    <TextView
                        android:id="@+id/verbTalk"
                        style="@style/ScummVerb"
                        android:text="@string/verb_talk" />
                </GridLayout>

                <!-- Inventar rechts -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inventoryBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@color/scumm_inv_bg"
                    android:clipToPadding="false"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/dialog"
        layout="@layout/view_dialog_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/duel"
        layout="@layout/view_duel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
