<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Grundschicht: Szene oben, SCUMM-Bedienleiste unten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Szenenbereich mit den darüberliegenden Overlays -->
        <FrameLayout
            android:id="@+id/sceneContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.appsonar.kapkrakenzahn.render.SceneView
                android:id="@+id/sceneView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Ortsname oben links -->
            <TextView
                android:id="@+id/locationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="#66000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFF5F1E6"
                android:textAppearance="?attr/textAppearanceCaption" />

            <!-- Menü-Button oben rechts -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMenu"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:minWidth="0dp"
                android:text="@string/game_menu"
                android:textColor="#FFF5F1E6"
                android:background="#66000000" />

            <!-- Kommentar-/Beschreibungszeile über der Leiste -->
            <TextView
                android:id="@+id/commentBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#88000000"
                android:padding="10dp"
                android:textColor="#FFF5F1E6"
                android:textAppearance="?attr/textAppearanceBody2"
                android:visibility="gone" />

            <!-- Holt die ausgeblendete Leiste zurück (Stufe „ausgeblendet") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBarShow"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:minWidth="0dp"
                android:background="#66000000"
                android:text="▴"
                android:textColor="@color/scumm_verb"
                android:textSize="20sp"
                android:visibility="gone"
                android:contentDescription="@string/bar_show" />

        </FrameLayout>

        <!-- Aufklappbare Verbtafel: Satzzeile + Verben (über der Dauer-Leiste) -->
        <LinearLayout
            android:id="@+id/expandedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/scumm_panel"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <!-- Satzzeile („Benutze Laterne mit …") -->
            <TextView
                android:id="@+id/sentenceLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp"
                android:textColor="@color/scumm_sentence"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Verbtafel (eine Reihe) -->
            <GridLayout
                android:id="@+id/verbGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="5">

                <TextView
                    android:id="@+id/verbWalk"
                    style="@style/ScummVerb"
                    android:text="@string/verb_walk" />

                <TextView
                    android:id="@+id/verbLook"
                    style="@style/ScummVerb"
                    android:text="@string/verb_look" />

                <TextView
                    android:id="@+id/verbTake"
                    style="@style/ScummVerb"
                    android:text="@string/verb_take" />

                <TextView
                    android:id="@+id/verbUse"
                    style="@style/ScummVerb"
                    android:text="@string/verb_use" />

                <TextView
                    android:id="@+id/verbTalk"
                    style="@style/ScummVerb"
                    android:text="@string/verb_talk" />
            </GridLayout>
        </LinearLayout>

        <!-- Schmale Dauer-Leiste: Auf-/Zuklappen, Inventar, Werkbank, Verlauf -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/scumm_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/inventoryBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/scumm_inv_bg"
                android:clipToPadding="false"
                android:padding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCraft"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/craft_button"
                android:textColor="@color/secondary"
                android:textSize="20sp"
                android:contentDescription="@string/craft_button_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHistory"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/history_button"
                android:textColor="#FFF5F1E6"
                android:textSize="20sp"
                android:contentDescription="@string/history_button_desc" />

            <!-- Chevrons ganz rechts: Verbtafel auf/zu und Leiste ausblenden -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPanelToggle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="▴"
                android:textColor="@color/scumm_verb"
                android:textSize="20sp"
                android:contentDescription="@string/toggle_controls" />

            <!-- Zweite Stufe: blendet in „nur Leiste" auch die Leiste selbst aus -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBarHide"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="▾"
                android:textColor="@color/scumm_verb"
                android:textSize="20sp"
                android:visibility="gone"
                android:contentDescription="@string/bar_hide" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/dialog"
        layout="@layout/view_dialog_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/duel"
        layout="@layout/view_duel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/craftOverlay"
        layout="@layout/view_crafting_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
