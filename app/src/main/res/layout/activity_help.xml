<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AppSonar.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/help_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/HelpHeading" android:text="Worum geht es?" />
            <TextView style="@style/HelpBody" android:text="@string/help_story" />

            <TextView style="@style/HelpHeading" android:text="Steuerung" />
            <TextView style="@style/HelpBody" android:text="@string/help_controls" />

            <TextView style="@style/HelpHeading" android:text="Gespräche" />
            <TextView style="@style/HelpBody" android:text="@string/help_dialog" />

            <TextView style="@style/HelpHeading" android:text="Speichern &amp; Laden" />
            <TextView style="@style/HelpBody" android:text="@string/help_saving" />

            <TextView style="@style/HelpHeading" android:text="Viele Wege, viel Abwechslung" />
            <TextView style="@style/HelpBody" android:text="@string/help_replay" />

            <TextView style="@style/HelpHeading" android:text="KI-Schlüssel (optional)" />
            <TextView style="@style/HelpBody" android:text="@string/help_key" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
